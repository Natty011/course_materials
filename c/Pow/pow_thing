double PowTen(int power)
{
    int index = 1;
    double ten = 10.0;
    double result = 1.0;
    
    if (power <= 0)
    {
        if(power == 0)
            return result;
        ten = 1.0/ten;
        power= -power;
    }
    
    result = ten;
    for ( ;index < power; index++)
    {
        result = result * ten;
