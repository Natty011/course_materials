# יצירת קובץ C++ חדש עם תבנית ברירת מחדל
# labp here   create----> ./here.cpp in current directory
# labp intro9 ~/projects/lab1 create----> ~/projects/lab1/intro9.cpp
function labp() 
{ 
    local dir="${2:-.}"   # אם $2 ריק – ברירת מחדל היא "."
    mkdir -p "$dir"
    cp ~/.labdefault.cpp "$dir/$1.cpp" && code "$dir/$1.cpp"
}

# יצירת קובץ C חדש עם תבנית ברירת מחדל
# labc sort main_test   create----> ./main_test/sort.c
function labc() 
{ 
    local dir="${2:-.}"
    mkdir -p "$dir"
    cp ~/.labdefaultc.c "$dir/$1.c" && code "$dir/$1.c" 
}

# קובץ header C

function labh() 
{ 
    local dir="${2:-.}"
    mkdir -p "$dir"
    cp ~/.labdefaulth.h "$dir/$1.h" && code "$dir/$1.h"
}

# קובץ header C++

# labhpp here   create----> ./here.hpp in current directory
# labhpp intro9 ~/projects/lab1 create----> ~/projects/lab1/intro9.hpp

function labhpp() 
{ 
    local dir="${2:-.}"
    mkdir -p "$dir"
    cp ~/.labdefaulthpp.hpp "$dir/$1.hpp" && code "$dir/$1.hpp"
}


# קומפילציית קובץ C
# קומפילציה והרצה לקובץ C עם alias gc (C89 release mode)
function run_gc()
{
    local file="$1"
    local base="${file%.c}"
    gc "$file" -o "$base.out" && ./"$base.out"
}

# קומפילציה והרצה לקובץ C עם alias gd (C89 debug mode)
function run_gd()
{
    local file="$1"
    local base="${file%.c}"
    gd "$file" -o "$base.out" && ./"$base.out"
}


# קומפילציה והרצה לקובץ C++ עם alias gc98 (C++98 release mode)
function run_gc98()
{
    local file="$1"
    local base="${file%.cpp}"
    gc98 "$file" -o "$base.out" && ./"$base.out"
}

# קומפילציה והרצה לקובץ C++ עם alias gd98 (debug mode)
function run_gd98()
{
    local file="$1"
    local base="${file%.cpp}"
    gd98 "$file" -o "$base.out" && ./"$base.out"
}


# קומפילציה והרצה לקובץ C++ עם alias gc11 (C++11 release mode)
function run_gc11()
{
    local file="$1"
    local base="${file%.cpp}"
    gc11 "$file" -o "$base.out" && ./"$base.out"
}

# קומפילציה והרצה לקובץ C++ עם alias gd11 (debug mode)
function run_gd11()
{
    local file="$1"
    local base="${file%.cpp}"
    gd11 "$file" -o "$base.out" && ./"$base.out"
}



# כניסה לספריית ~/test
function cdtest() 
{
    cd ~/test
}

# מחיקה לפי שם קובץ או את כל קבצי ההרצה
# rmout myprog or myprog.out    ימחק את הקובץ myprog.out בלבד
# rmout            ידפיס הודעת שימוש
#rmout all          מוחק את כל קבצי .out כולל a.out

function rmout() 
{
    if [ -z "$1" ]; then
        echo "Usage:"
        echo "  rmout <filename_without_extension>  # Delete specific .out file"
        echo "  rmout <filename.out>                # Also works"
        echo "  rmout all                           # Delete all .out files + a.out"
        return 1
    fi

    if [ "$1" = "all" ]; then
        rm -f a.out *.out
        echo "All .out files deleted"
        return
    fi

    local file="$1"

    # אם המשתמש לא כתב .out - נוסיף אותה
    case "$file" in
        *.out) ;;                      # אל תעשה כלום אם כבר יש סיומת .out
        *) file="$file.out" ;;        # אחרת הוסף אותה
    esac

    if [ -f "$file" ]; then
        rm -f "$file"
        echo "Deleted $file"
    else
        echo "File '$file' not found"
    fi
}



