#  .myfuncs must be in the directory that the c files there for excecuation

source .myfuncs

gc hello.c

## must be int before main
## main must be return number in the end

gd hello.c

# create exe file of hello.c  with the name hello( can choose any name)
#this file we use for valgrind chacking

gc hello.c -o hello

# valgrind alias to check leaks in hello exe file

vlg ./hello
